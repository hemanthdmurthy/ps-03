# Server Settings
PORT=8000
ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@db:5432/company_intel

# Redis & Celery Settings
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Caching Settings
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# LLM Keys
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Optional Search API Key
TAVILY_API_KEY=your-tavily-api-key

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=company-research-agent

# OpenTelemetry Configuration
# Master kill switch — set to "false" to completely disable all tracing
OTEL_ENABLED=true
# OTel-spec standard endpoint (e.g. http://otel-collector:4317 for Docker, http://localhost:4317 for local)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Protocol: "grpc" (default) or "http/protobuf"
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Service identity
OTEL_SERVICE_NAME=placement-intel-backend
# Additional resource attributes (comma-separated key=value)
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.version=1.0.0
# "true" to force ConsoleSpanExporter for local debugging
OTEL_EXPORT_CONSOLE=false
